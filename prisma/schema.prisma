generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ADMINISTRATOR
  OPERATOR_PUSDALOPS
  OPERATOR_KODAM
  ANALYST
  PIMPINAN
}

enum OperationalStatus {
  KONDUSIF
  WASPADA
  SIAGA
}

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

enum RecordStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String     @id @default(cuid())
  externalIdentityId String?    @unique
  name               String
  username           String     @unique
  email              String?    @unique
  password           String? // Legacy only; never stores the IdP password.
  role               UserRole   @default(OPERATOR_KODAM)
  kodamId            String?
  kodam              Kodam?     @relation(fields: [kodamId], references: [id])
  status             String     @default("ACTIVE")
  lastLoginAt        DateTime?
  auditLogs          AuditLog[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Kodam {
  id              String            @id @default(cuid())
  slug            String?
  code            String            @unique
  name            String
  region          String
  location        String            @default("")
  latitude        Float?
  longitude       Float?
  status          OperationalStatus @default(KONDUSIF)
  personnel       Int               @default(0)
  incidentCount   Int               @default(0)
  deployed        Int               @default(0)
  logoFilename    String?
  logoMimeType    String?
  logoUpdatedAt   DateTime?
  users           User[]
  incidents       Incident[]
  resources       Resource[]
  reports         Report[]
  bangsitArchives BangsitArchive[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([slug])
}

model OperationalRecord {
  id            String   @id @default(cuid())
  module        String
  primary       String
  secondary     String
  detail        String
  status        String
  latitude      Float?
  longitude     Float?
  crowdEstimate Int?
  personnel     Int?
  sortOrder     Int      @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([module, sortOrder])
  @@index([module, updatedAt])
}

model Incident {
  id            String              @id @default(cuid())
  kodamId       String
  kodam         Kodam               @relation(fields: [kodamId], references: [id])
  category      String
  title         String
  description   String              @db.Text
  location      String
  latitude      Float?
  longitude     Float?
  incidentDate  DateTime
  incidentTime  String
  status        OperationalStatus   @default(KONDUSIF)
  personnel     Int                 @default(0)
  crowdEstimate Int                 @default(0)
  source        String?
  alerts        Alert[]
  documents     DocumentReference[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([kodamId, incidentDate])
  @@index([category, status])
}

model DocumentReference {
  id              String   @id @default(cuid())
  incidentId      String
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  nextcloudFileId String?
  filename        String
  mimeType        String?
  path            String
  uploadedBy      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([incidentId, path])
  @@index([incidentId, createdAt])
}

model Alert {
  id         String            @id @default(cuid())
  incidentId String?
  incident   Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  level      AlertLevel
  title      String
  message    String            @db.Text
  kodam      String            @default("Nasional")
  metric     String            @default("-")
  status     OperationalStatus
  createdBy  String?
  createdAt  DateTime          @default(now())
}

model Resource {
  id        String   @id @default(cuid())
  kodamId   String
  kodam     Kodam    @relation(fields: [kodamId], references: [id])
  type      String
  name      String
  quantity  Int
  deployed  Int      @default(0)
  status    String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kodamId, type])
  @@index([status])
}

model Report {
  id         String       @id @default(cuid())
  kodamId    String?
  kodam      Kodam?       @relation(fields: [kodamId], references: [id], onDelete: SetNull)
  type       String
  title      String
  reportDate DateTime
  content    Json
  status     RecordStatus @default(DRAFT)
  createdBy  String?
  approvedBy String?
  publishedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([kodamId, reportDate])
  @@index([status, reportDate])
}

model BangsitArchive {
  id              String   @id @default(cuid())
  reportId        String   @unique
  kodamId         String
  kodam           Kodam    @relation(fields: [kodamId], references: [id])
  title           String
  filename        String
  mimeType        String
  path            String   @unique
  nextcloudFileId String?
  payload         Json
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([kodamId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  entity        String
  entityId      String?
  oldValue      Json?
  newValue      Json?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  correlationId String
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([correlationId])
  @@index([createdAt])
}

model MapAnnotationLayout {
  id           String   @id @default(cuid())
  annotationId String   @unique
  offsetX      Int
  offsetY      Int
  updatedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

model MapPoint {
  id          String            @id @default(cuid())
  title       String
  kodam       String
  location    String
  category    String
  description String            @db.Text
  status      OperationalStatus @default(WASPADA)
  personnel   Int               @default(0)
  latitude    Float
  longitude   Float
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([createdAt])
  @@index([status])
}
