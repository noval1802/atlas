ATLAS_POSTGRES_PASSWORD="replace-with-random-postgres-password"
DATABASE_URL="postgresql://atlas:replace-with-random-postgres-password@localhost:5432/atlas?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Generic OIDC / Keycloak client. Do not commit the real client secret.
OIDC_PROVIDER_NAME="SSO Organisasi"
OIDC_ISSUER="http://localhost:8080/realms/atlas"
OIDC_CLIENT_ID="atlas"
OIDC_CLIENT_SECRET="replace-with-oidc-client-secret"

# Local development only. The provider is forcibly disabled in production.
ENABLE_DEV_LOGIN="false"
DEV_LOGIN_USERNAME="admin.pusdalops"
DEV_LOGIN_PASSWORD="replace-with-local-development-password"

# Local document archive. Files stay on the ATLAS server.
DOCUMENT_STORAGE_DIR="./uploads/documents"
DOCUMENT_MAX_UPLOAD_BYTES="26214400"
